set_property PACKAGE_PIN F17 [get_ports VCXO_OUT]
set_property IOSTANDARD LVDS_25 [get_ports VCXO_OUT]
set_property PACKAGE_PIN E17 [get_ports VCXO_OUTB]
set_property IOSTANDARD LVDS_25 [get_ports VCXO_OUTB]

