set_property DIFF_TERM TRUE [get_ports {PLL_OUT1 PLL_OUT1B}]

set_clock_groups -asynchronous \
  -group [get_clocks -include_generated_clocks vcxo_clock] \
  -group [get_clocks -include_generated_clocks PLL_OUT1]

