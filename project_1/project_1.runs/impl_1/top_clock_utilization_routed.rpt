add_cells_to_pblock [get_pblocks  {CLKAG_vcxo_clk_125m_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=u_ref_clk_gen/u_clk_wizard/inst/mmcm_adv_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="vcxo_clk_125m_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_vcxo_clk_125m_BUFG}] -add {CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X0Y3:CLOCKREGION_X0Y3}
#endgroup

